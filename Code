#-------------------------------  Movement ----------------------------

DEADZONE = 10          
MAX_WHEEL_SPEED = 255
DRIVE_GAIN = 3         
SLIDE_GAIN = -1.5       
TURN_GAIN = 3          




# ───────────────────────── MOVEMENT ─────────────────────────
WHEEL_TUNE = {"LF": 1.0, "LB": 1.0, "RF": 1.1, "RB": 1.05}

def clamp(v, limit):
    return max(-limit, min(limit, v))

def control_movement():
    lx = gamepad.get_joystick("Lx")
    ly = gamepad.get_joystick("Ly")
    rx = gamepad.get_joystick("Rx")

    # ตัดสัญญาณรบกวนจากจอย
    if abs(lx) < DEADZONE:
        lx = 0
    if abs(ly) < DEADZONE:
        ly = 0
    if abs(rx) < DEADZONE:
        rx = 0

    vx = -lx * SLIDE_GAIN
    vy = ly * DRIVE_GAIN
    w  = -rx * TURN_GAIN   # 🔧 ถ้าหมุนผิดทิศให้เอา - ออก

    lf = (vy - vx + w) * WHEEL_TUNE["LF"]
    lb = (vy + vx + w) * WHEEL_TUNE["LB"]
    rf = (vy + vx - w) * WHEEL_TUNE["RF"]
    rb = (vy - vx - w) * WHEEL_TUNE["RB"]

    en["LF"].set_speed( clamp(lf, MAX_WHEEL_SPEED))
    en["LB"].set_speed( clamp(lb, MAX_WHEEL_SPEED))
    en["RF"].set_speed(-clamp(rf, MAX_WHEEL_SPEED))
    en["RB"].set_speed(-clamp(rb, MAX_WHEEL_SPEED))
# ───────────────────────── FEED ─────────────────────────
feed_state = 0
prev_feed_n1 = 0
prev_feed_n2 = 0
    

def feed(a: int, b: int, c: int):
    power_expand_board.set_power("DC2", a)
    power_expand_board.set_power("DC1", b)
    power_expand_board.set_power("DC3", c)

def stop_feed():
    power_expand_board.set_power("DC1", 0)
    power_expand_board.set_power("DC2", 0)
    power_expand_board.set_power("DC3", 0)

def feed_control():
    global feed_state, prev_feed_n1, prev_feed_n2

    n1 = feed_up
    n2 = feed_down

    if n1 and not prev_feed_n1:
        feed_state = 1
    if n2 and not prev_feed_n2:
        feed_state = 2

    prev_feed_n1 = n1
    prev_feed_n2 = n2

    if gamepad.is_key_pressed("L1"):
        feed_state = 0

    if feed_state == 1:
        feed(FEED_POWER, FEED_POWER, FEED_POWER) 
    elif feed_state == 2:
        feed(-FEED_POWER, -FEED_POWER, -FEED_POWER)  
    else:
        stop_feed()
