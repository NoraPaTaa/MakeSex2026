def servo_m5_control():
    if gamepad.is_key_pressed("Up"):
        sv["lifter"].move_to(SERVO_M5_ANGLE_UP,   SERVO_M5_SPEED)
    elif gamepad.is_key_pressed("Left"):
        sv["lifter"].move_to(SERVO_M5_ANGLE_MID,  SERVO_M5_SPEED)
    elif gamepad.is_key_pressed("Down"):
        sv["lifter"].move_to(SERVO_M5_ANGLE_DOWN, SERVO_M5_SPEED)
# ── BLOCK SUCK (กดสลับเปิด/ปิด DC4+DC5) ──────────────────────────
def Block_Suck():
    global _suck_state, _prev_suck_btn

    btn = gamepad.is_key_pressed(BTN_BLOCK_SUCK)

    if btn and not _prev_suck_btn:
        _suck_state = 0 if _suck_state == 1 else 1

    _prev_suck_btn = btn

    if _suck_state == 1:
        power_expand_board.set_power("DC4",  BLOCK_SUCK_POWER)
        power_expand_board.set_power("DC5", -BLOCK_SUCK_POWER)
        sv["shooter"].move_to(SERVO_ANGLE_UP, SERVO_SPEED)    # ← servo M6 ไปตำแหน่ง Up ตอน suck เปิด
    else:
        power_expand_board.set_power("DC4", 0)
        power_expand_board.set_power("DC5", 0)
        sv["shooter"].move_to(SERVO_ANGLE_DOWN, SERVO_SPEED)  # ← servo M6 กลับตำแหน่ง Down ตอน suck ปิด


# ── BLOCK RELEASE (กดครั้งเดียว เข้า 3 วิ แล้วออก 0.7 วิ) ────────
def Block_Release():
    global _release_phase, _release_timer, _prev_rel_btn

    now = time.ticks_ms()
    btn = gamepad.is_key_pressed(BTN_BLOCK_RELEASE)

    if btn and not _prev_rel_btn and _release_phase == 0:
        _release_phase = 1
        _release_timer = now

    _prev_rel_btn = btn

    if _release_phase == 1:
        power_expand_board.set_power("DC8", -BLOCK_RELEASE_POWER)
        sv["shooter"].move_to(SERVO_ANGLE_UP, SERVO_SPEED)    # ← servo M6 ไปตำแหน่ง Up ตอนดันเข้า
        if now - _release_timer >= BLOCK_IN_TIME:
            _release_phase = 2
            _release_timer = now

    elif _release_phase == 2:
        power_expand_board.set_power("DC8",  BLOCK_RELEASE_POWER)
        sv["shooter"].move_to(SERVO_ANGLE_DOWN, SERVO_SPEED)  # ← servo M6 กลับตำแหน่ง Down ตอนดันออก
        if now - _release_timer >= BLOCK_OUT_TIME:
            power_expand_board.set_power("DC8", 0)
            _release_phase = 0

    else:
        power_expand_board.set_power("DC8", 0)

# ── GRIPPER ────────────────────────────────────────────────────────
def gripper_control():
    global _grip_phase, _grip_timer, _prev_grip, _prev_rel

    now  = time.ticks_ms()
    grip = gamepad.is_key_pressed(BTN_GRIP)
    rel  = gamepad.is_key_pressed(BTN_RELEASE)

    if grip and not _prev_grip:
        _grip_phase = 1
    if rel and not _prev_rel:
        _grip_phase = 2
        _grip_timer = now

    _prev_grip = grip
    _prev_rel  = rel

    if _grip_phase == 1:
        power_expand_board.set_power(GRIP_PORT,  GRIP_POWER)
    elif _grip_phase == 2:
        power_expand_board.set_power(GRIP_PORT, -50)
        if now - _grip_timer >= GRIP_TIME:
            power_expand_board.set_power(GRIP_PORT, 0)
            _grip_phase = 0
    else:
        power_expand_board.set_power(GRIP_PORT, 0)


# ── LIFT ───────────────────────────────────────────────────────────
