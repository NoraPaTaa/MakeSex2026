from mbuild import power_expand_board
import novapi
from mbuild import power_manage_module
from mbuild.encoder_motor import encoder_motor_class
from mbuild import gamepad
from mbuild.smartservo import smartservo_class
from mbuild.led_matrix import led_matrix_class
import time

# ── ปุ่ม MODE ──────────────────────────────────────────────────────
BTN_MODE1   = "≡"
BTN_MODE2   = "+"

# ── ปุ่ม FEED (โหมด 1) ────────────────────────────────────────────
BTN_FEED_FWD  = "N3"
BTN_FEED_REV  = "N2"
BTN_FEED_STOP = "L1"

# ── ปุ่ม BRUSHLESS (โหมด 1) ───────────────────────────────────────
BTN_BL_HIGH = "R1"
BTN_BL_LOW  = "Left"
BTN_BL_OFF  = "R2"

# ── ปุ่ม SERVO (โหมด 1) ───────────────────────────────────────────
BTN_SERVO_UP   = "Up"
BTN_SERVO_DOWN = "Down"

# ── ปุ่ม GRIPPER (โหมด 2) ─────────────────────────────────────────
BTN_GRIP    = "N4"
BTN_RELEASE = "N1"

# ── ปุ่ม LIFT (โหมด 2) ────────────────────────────────────────────
BTN_LIFT_UP   = "N2"
BTN_LIFT_DOWN = "N3"

# ── ค่า FEED ──────────────────────────────────────────────────────
FEED_POWER = 90
FEED_PORT  = "DC2"

# ── ค่า BRUSHLESS ─────────────────────────────────────────────────
BL_POWER_HIGH = 90
BL_POWER_LOW  = 75
BL_PORT1      = "BL1"
BL_PORT2      = "BL2"

# ── ค่า SERVO ─────────────────────────────────────────────────────
SERVO_ANGLE_UP      = 0    # 🔧 องศาตอนกด Up
SERVO_ANGLE_DOWN    = -30    # 🔧 องศาตอนกด Down
SERVO_SPEED         = 10    # 🔧 ความเร็วหมุน (0-100)
SERVO_CURRENT_LIMIT = 1250  # 🔧 กระแสสูงสุดก่อนตัดไฟ (ป้องกันไฟแดง)

# ── ค่า GRIPPER ───────────────────────────────────────────────────
GRIP_POWER = 70
GRIP_TIME  = 150
GRIP_PORT  = "DC7"

# ── ค่า LIFT ──────────────────────────────────────────────────────
LIFT_UP_POWER   = -80
LIFT_DOWN_POWER =  500
LIFT_HOLD_POWER = -10
LIFT_PORT       = "DC8"

# ── ค่า MOVEMENT ──────────────────────────────────────────────────
DEADZONE        = 10
MAX_WHEEL_SPEED = 255
DRIVE_GAIN      = 3.0
SLIDE_GAIN      = -2.0
TURN_GAIN       = 3.0

WHEEL_TUNE = {
    "LF": 1.00,
    "LB": 1.00,
    "RF": 1.10,
    "RB": 1.05,
}

# ── HARDWARE SETUP ─────────────────────────────────────────────────
en = {
    "LF": encoder_motor_class("M1", "INDEX1"),
    "LB": encoder_motor_class("M3", "INDEX1"),
    "RF": encoder_motor_class("M2", "INDEX1"),
    "RB": encoder_motor_class("M4", "INDEX1"),
}
sv = {
    "shooter": smartservo_class("M6", "INDEX1"),
}
mode = "1"

# ══════════════════════════════════════════════════════════════════
# ห้ามแก้ใต้นี้ถ้าไม่จำเป็น
# ══════════════════════════════════════════════════════════════════

def clamp(v, limit):
    return max(-limit, min(limit, v))

# ── MOVEMENT ───────────────────────────────────────────────────────
def control_movement():
    lx = gamepad.get_joystick("Lx")
    ly = gamepad.get_joystick("Ly")
    rx = gamepad.get_joystick("Rx")

    if abs(lx) < DEADZONE: lx = 0
    if abs(ly) < DEADZONE: ly = 0
    if abs(rx) < DEADZONE: rx = 0

    vx = -lx * SLIDE_GAIN
    vy =  ly * DRIVE_GAIN
    w  = -rx * TURN_GAIN

    lf = (vy - vx + w) * WHEEL_TUNE["LF"]
    lb = (vy + vx + w) * WHEEL_TUNE["LB"]
    rf = (vy + vx - w) * WHEEL_TUNE["RF"]
    rb = (vy - vx - w) * WHEEL_TUNE["RB"]

    en["LF"].set_speed( clamp(lf, MAX_WHEEL_SPEED))
    en["LB"].set_speed( clamp(lb, MAX_WHEEL_SPEED))
    en["RF"].set_speed(-clamp(rf, MAX_WHEEL_SPEED))
    en["RB"].set_speed(-clamp(rb, MAX_WHEEL_SPEED))


# ── FEED ───────────────────────────────────────────────────────────
_feed_state    = 0
_prev_feed_fwd = 0
_prev_feed_rev = 0

def feed_control():
    global _feed_state, _prev_feed_fwd, _prev_feed_rev

    fwd = gamepad.is_key_pressed(BTN_FEED_FWD)
    rev = gamepad.is_key_pressed(BTN_FEED_REV)

    if fwd and not _prev_feed_fwd: _feed_state = 1
    if rev and not _prev_feed_rev: _feed_state = 2
    if gamepad.is_key_pressed(BTN_FEED_STOP): _feed_state = 0

    _prev_feed_fwd = fwd
    _prev_feed_rev = rev

    if _feed_state == 1:
        power_expand_board.set_power(FEED_PORT,  FEED_POWER)
    elif _feed_state == 2:
        power_expand_board.set_power(FEED_PORT, -FEED_POWER)
    else:
        power_expand_board.set_power(FEED_PORT, 0)


# ── BRUSHLESS ──────────────────────────────────────────────────────
_bl_state     = 0
_prev_bl_high = 0
_prev_bl_low  = 0
_prev_bl_off  = 0

def brushless_control():
    global _bl_state, _prev_bl_high, _prev_bl_low, _prev_bl_off

    high = gamepad.is_key_pressed(BTN_BL_HIGH)
    low  = gamepad.is_key_pressed(BTN_BL_LOW)
    off  = gamepad.is_key_pressed(BTN_BL_OFF)

    if high and not _prev_bl_high: _bl_state = 1
    if low  and not _prev_bl_low:  _bl_state = 2
    if off  and not _prev_bl_off:  _bl_state = 0

    _prev_bl_high = high
    _prev_bl_low  = low
    _prev_bl_off  = off

    if _bl_state == 1:
        power_expand_board.set_power(BL_PORT1, BL_POWER_HIGH)
        power_expand_board.set_power(BL_PORT2, BL_POWER_HIGH)
    elif _bl_state == 2:
        power_expand_board.set_power(BL_PORT1, BL_POWER_LOW)
        power_expand_board.set_power(BL_PORT2, BL_POWER_LOW)
    else:
        power_expand_board.set_power(BL_PORT1, 0)
        power_expand_board.set_power(BL_PORT2, 0)


# ── SERVO ──────────────────────────────────────────────────────────
def red_servo():
    if sv["shooter"].get_value("current") > SERVO_CURRENT_LIMIT:
        sv["shooter"].set_power(0)

def servo_control():
    if gamepad.is_key_pressed(BTN_SERVO_UP):
        sv["shooter"].move_to(SERVO_ANGLE_UP,   SERVO_SPEED)
    elif gamepad.is_key_pressed(BTN_SERVO_DOWN):
        sv["shooter"].move_to(SERVO_ANGLE_DOWN, SERVO_SPEED)


# ── GRIPPER ────────────────────────────────────────────────────────
_grip_phase = 0
_grip_timer = 0
_prev_grip  = 0
_prev_rel   = 0

def gripper_control():
    global _grip_phase, _grip_timer, _prev_grip, _prev_rel

    now  = time.ticks_ms()
    grip = gamepad.is_key_pressed(BTN_GRIP)
    rel  = gamepad.is_key_pressed(BTN_RELEASE)

    if grip and not _prev_grip:
        _grip_phase = 1
    if rel and not _prev_rel:
        _grip_phase = 2
        _grip_timer = now

    _prev_grip = grip
    _prev_rel  = rel

    if _grip_phase == 1:
        power_expand_board.set_power(GRIP_PORT, GRIP_POWER)
    elif _grip_phase == 2:
        power_expand_board.set_power(GRIP_PORT,  -GRIP_POWER)
        if now - _grip_timer >= GRIP_TIME:
            power_expand_board.set_power(GRIP_PORT, 0)
            _grip_phase = 0
    else:
        power_expand_board.set_power(GRIP_PORT, 0)


# ── LIFT ───────────────────────────────────────────────────────────
def lift_control():
    if gamepad.is_key_pressed(BTN_LIFT_UP):
        power_expand_board.set_power(LIFT_PORT, LIFT_UP_POWER)
    elif gamepad.is_key_pressed(BTN_LIFT_DOWN):
        power_expand_board.set_power(LIFT_PORT, LIFT_DOWN_POWER)
    else:
        power_expand_board.set_power(LIFT_PORT, LIFT_HOLD_POWER)


# ── MODE ───────────────────────────────────────────────────────────
def change_mode():
    global mode
    if gamepad.is_key_pressed(BTN_MODE1): mode = "1"
    if gamepad.is_key_pressed(BTN_MODE2): mode = "2"


# ══════════════════════════════════════════════════════════════════
# MAIN LOOP
# ══════════════════════════════════════════════════════════════════
while True:
    if power_manage_module.is_auto_mode():
        pass
        while not not power_manage_module.is_auto_mode():
            pass
    else:
        change_mode()
        red_servo()

        if mode == "1":
            control_movement()
            feed_control()
            brushless_control()
            servo_control()
        else:
            control_movement()
            gripper_control()
            lift_control()
