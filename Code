# ───────────────────────── GRIPPER ─────────────────────────
prev_l2 = 0
prev_r2 = 0
gripper_phase = 0      
gripper_timer = 0

def gripper_control():
    global prev_l2, prev_r2, gripper_phase, gripper_timer

    now = time.ticks_ms()
    if hold and not prev_r2:
        gripper_phase = 1

    if release and not prev_l2:
        gripper_phase = 2
        gripper_timer = now

    prev_r2 = hold
    prev_l2 = release

    if gripper_phase == 1:
        power_expand_board.set_power("DC8", -100)  

    elif gripper_phase == 2:
        power_expand_board.set_power("DC8", 100)   
        if now - gripper_timer >= GRIPPER_L2_TIME:
            power_expand_board.set_power("DC8", 0)
            gripper_phase = 0

    else:
        power_expand_board.set_power("DC8", 0)


# ───────────────────────── LIFT ─────────────────────────

def lift_control():
    if lift_up:
        power_expand_board.set_power("DC4", -80)
    elif lift_down:
        power_expand_board.set_power("DC4", 50)
    else:
        power_expand_board.set_power("DC4", -10)


# ───────────────────────── BRUSHLESS ─────────────────────────
prev_r1_bl = 0
prev_r2_bl = 0
prev_left_bl = 0
bl_state = 0         

BL_POWER = 80        
BL_POWER_LOW = 75    

def brushless_control():
    global prev_r1_bl, prev_r2_bl, prev_left_bl, bl_state

    if B_stage1 and not prev_r1_bl:
        bl_state = 1   # กด R1 = เปิดเต็มติดค้าง

    if B_stage2 and not prev_left_bl:
        bl_state = 2   # กด Left = เปิด 75% ติดค้าง

    if B_stop and not prev_r2_bl:
        bl_state = 0   # กด R2 = ปิด

    prev_r1_bl   = B_stage1
    prev_r2_bl   = B_stop
    prev_left_bl = B_stage2

    if bl_state == 1:
        power_expand_board.set_power("BL1", BL_POWER)
        power_expand_board.set_power("BL2", BL_POWER)
    elif bl_state == 2:
        power_expand_board.set_power("BL1", BL_POWER_LOW)
        power_expand_board.set_power("BL2", BL_POWER_LOW)
    else:
        power_expand_board.set_power("BL1", 0)
        power_expand_board.set_power("BL2", 0)
        
# ───────────────────────── SERVO ─────────────────────────
SERVO_CURRENT_LIMIT = 1250 

def red_servo():
    if sv["shooter"].get_value("current") > SERVO_CURRENT_LIMIT:
        sv["shooter"].set_power(0)

def Servo_updown():
    if gamepad.is_key_pressed("Up"):
        sv["shooter"].move(-10, 10)  
    elif gamepad.is_key_pressed("Down"):
        sv["shooter"].move(10, 10)  
def change_mode():
    global mode
    if gamepad.is_key_pressed("≡"):
        mode = "1"
    elif gamepad.is_key_pressed("+"):
        mode = "2"
   
