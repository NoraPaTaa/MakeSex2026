def auto_move(vx, vy, w):
    lf = (vy - vx + w) * WHEEL_TUNE["LF"]
    lb = (vy + vx + w) * WHEEL_TUNE["LB"]
    rf = (vy + vx - w) * WHEEL_TUNE["RF"]
    rb = (vy - vx - w) * WHEEL_TUNE["RB"]

    en["LF"].set_speed(clamp(lf, MAX_WHEEL_SPEED))
    en["LB"].set_speed(clamp(lb, MAX_WHEEL_SPEED))
    en["RF"].set_speed(-clamp(rf, MAX_WHEEL_SPEED))
    en["RB"].set_speed(-clamp(rb, MAX_WHEEL_SPEED))


def stop():
    en["LF"].set_speed(0)
    en["LB"].set_speed(0)
    en["RF"].set_speed(0)
    en["RB"].set_speed(0)


# ── MOVEMENT ───────────────────────────────────────────────────────

def forward(speed=100):
    auto_move(0, speed, 0)


def backward(speed=100):
    auto_move(0, -speed, 0)


def slide_left(speed=100):
    auto_move(-speed, 0, 0)


def slide_right(speed=100):
    auto_move(speed, 0, 0)


def turn_left(speed=100):
    auto_move(0, 0, speed)


def turn_right(speed=100):
    auto_move(0, 0, -speed)


