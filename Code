def distance_back():
    return Ranging_back.get_distance()


# ── WAIT UNTIL : LEFT ─────────────────────────────────────────────

def wait_until_left_less_than(distance_cm):
    while distance_left() > distance_cm:
        time.sleep_ms(10)
    stop()


def wait_until_left_greater_than(distance_cm):
    while distance_left() < distance_cm:
        time.sleep_ms(10)
    stop()


# ── WAIT UNTIL : BACK ─────────────────────────────────────────────

def wait_until_back_less_than(distance_cm):
    while distance_back() > distance_cm:
        time.sleep_ms(10)
    stop()


def wait_until_back_greater_than(distance_cm):
    while distance_back() < distance_cm:
        time.sleep_ms(10)
    stop()

def approach_back(target, fast_speed=150, slow_speed=60, slow_distance=125):

    backward(fast_speed)

    while distance_back() > slow_distance:
        time.sleep_ms(10)

    backward(slow_speed)

    while distance_back() > target:
        time.sleep_ms(10)

    stop()
    
